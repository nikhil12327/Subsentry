generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}
enum DiscountType {
  FIXED
  PERCENTAGE
}

model Organization {
  id String @id @default(cuid())
  name String
  currency String @default("INR")
  timezone String @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  users User[]
  customers Customer[]
  products Product[]
  plans Plan[]
  taxRules TaxRule[]
  discountRules DiscountRule[]
  subscriptions Subscription[]
  invoices Invoice[]
  payments Payment[]
  auditLogs AuditLog[]
}

model User {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  email String @unique
  passwordHash String
  name String
  role Role @default(CUSTOMER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  customer Customer?
  sessions Session[]
  resetTokens PasswordResetToken[]
  @@index([organizationId, role])
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}

model Customer {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  name String
  email String
  company String?
  taxId String?
  phone String?
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  invoices Invoice[]
  payments Payment[]
  @@unique([organizationId, email])
  @@index([organizationId, name])
}

model Product {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  type String
  price Decimal @db.Decimal(12,2)
  cost Decimal @db.Decimal(12,2)
  notes String?
  archived Boolean @default(false)
  variants ProductVariant[]
  @@unique([organizationId, name])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  additionalPrice Decimal @db.Decimal(12,2)
  @@unique([productId, name])
}

model Plan {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  price Decimal @db.Decimal(12,2)
  frequency Frequency
  minimumQuantity Int @default(1)
  availableFrom DateTime?
  availableUntil DateTime?
  autoClose Boolean @default(false)
  allowPause Boolean @default(true)
  allowEarlyClose Boolean @default(true)
  allowRenewal Boolean @default(true)
  archived Boolean @default(false)
  subscriptions Subscription[]
  @@unique([organizationId, name])
}

model TaxRule {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  jurisdiction String
  rate Decimal @db.Decimal(7,4)
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
}

model DiscountRule {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  type DiscountType
  value Decimal @db.Decimal(12,2)
  minimumPurchase Decimal? @db.Decimal(12,2)
  minimumQuantity Int @default(1)
  startsAt DateTime?
  endsAt DateTime?
  maxRedemptions Int?
  redeemedCount Int @default(0)
  active Boolean @default(true)
}

model Subscription {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  number String
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  planId String
  plan Plan @relation(fields: [planId], references: [id])
  startDate DateTime
  expiryDate DateTime?
  nextBillingDate DateTime?
  anchorDay Int
  frequency Frequency
  quantity Int @default(1)
  unitPrice Decimal @db.Decimal(12,2)
  status SubscriptionStatus @default(DRAFT)
  paymentTerms String @default("Net 15")
  createdAt DateTime @default(now())
  invoices Invoice[]
  @@unique([organizationId, number])
  @@index([organizationId, status, nextBillingDate])
}

model Invoice {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  number String
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  periodStart DateTime?
  periodEnd DateTime?
  dueDate DateTime
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2) @default(0)
  tax Decimal @db.Decimal(12,2) @default(0)
  total Decimal @db.Decimal(12,2)
  paidAmount Decimal @db.Decimal(12,2) @default(0)
  status InvoiceStatus @default(DRAFT)
  idempotencyKey String?
  createdAt DateTime @default(now())
  lines InvoiceLine[]
  allocations PaymentAllocation[]
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, dueDate])
}

model InvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  lineTotal Decimal @db.Decimal(12,2)
}

model Payment {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  amount Decimal @db.Decimal(12,2)
  method String
  reference String?
  notes String?
  paidAt DateTime @default(now())
  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  amount Decimal @db.Decimal(12,2)
  @@unique([paymentId, invoiceId])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  userId String?
  action String
  entity String
  entityId String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
